# Copie para .env.local (ignorado pelo git). Todos os valores abaixo são OPCIONAIS e PÚBLICOS (NEXT_PUBLIC_*):
# aparecem no navegador de qualquer forma. NUNCA coloque senhas, tokens ou chaves de API aqui com prefixo NEXT_PUBLIC_.

# Endereço oficial do site (canonical, sitemap, Open Graph). Troque ao migrar para domínio próprio.
NEXT_PUBLIC_SITE_URL=https://info.zimmertech.workers.dev

# Código de verificação do Google Search Console (meta tag), se for usar.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
